{
  "manifest_version": 3,
  "name": "VidzyAI - YouTube Video AI Assistant",
  "version": "1.0.0",
  "description": "VidzyAI - YouTube Video AI Assistant. Chat with any YouTube video in real-time using AI and LangChain.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://vidzyai.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vidzy - Chat with Video",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
